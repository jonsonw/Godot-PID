# Internal helper: build one SymbolDef from parsed data.
# 内部辅助：从解析数据构造一个 SymbolDef。
static func _gpMk(gpId: String, gpChineseName: String, gpCat: String, gpPorts: Array[Dictionary], gpShape: Dictionary, gpEnv: Vector2, gpTagPrefix: String = "", gpSchemaFields: Array[Dictionary] = [], gpMount: Dictionary = {}) -> GPSymbolDef:
	var gpD: GPSymbolDef = GPSymbolDef.new()
	gpD.gpId = gpId
	gpD.gpDisplayName = gpChineseName
	gpD.gpCategory = gpCat
	gpD.gpDefaultSize = gpEnv
	# M9: the category's factory tag prefix ("P" for a pump). The runtime
	# falls back to the category table when this is empty.
	# M9：类别的出厂位号前缀（泵为 "P"）。为空时运行期回落到类别表。
	gpD.gpTagPrefix = gpTagPrefix
	# P0 unified model: the generated dict specs are converted into the shared GPShape / GPPort
	# types here, so the library, the editor and the canvas all consume one model.
	# P0 统一模型：此处把生成的字典规格转换为共用的 GPShape / GPPort 类型，
	# 使图元库、编辑器与画布共用同一模型。
	gpD.gpPorts = GPPortSpec.gpFromDicts(gpPorts)
	gpD.gpShapes = GPShapeSpec.gpFromSpec(gpShape)
	# M8: wire the typed property schema. It was BUILT but never ASSIGNED, so the
	# inspector had no fields to show for factory symbols — this is the missing
	# half of "edit the library, every project follows".
	# M8：接上类型化属性 schema。它此前「已建成但未赋值」，导致出厂图元在属性面板里
	# 无字段可显示 —— 这正是「改库即全项目同步」缺失的那一半。
	if not gpSchemaFields.is_empty():
		var gpSc: GPPropertySchema = GPPropertySchema.new()
		for gpF in gpSchemaFields:
			var gpPd: GPPropertyDef = GPPropertyDef.new()
			gpPd.gpFromDict(gpF as Dictionary)
			gpSc.gpFields.append(gpPd)
		gpD.gpSchema = gpSc
	# P3 mounting: anchors / mount kind / canonical mount angle / label slots. Only the
	# keys actually present are applied, so a symbol with no mounting keeps every
	# default value and serialises exactly as it did before this feature.
	# P3 挂载：锚点 / 挂载类型 / 规范安装角 / 文本槽。只应用确实携带的键，
	# 故无挂载的图元保持全部默认值，序列化结果与引入该功能之前完全一致。
	if not gpMount.is_empty():
		var gpAnchorsIn: Variant = gpMount.get("attach_points", [])
		if gpAnchorsIn is Array:
			gpD.gpAttachPoints = GPAttachPoint.gpFromDicts(gpAnchorsIn as Array)
		gpD.gpMountKind = str(gpMount.get("mount_kind", ""))
		gpD.gpBaseMountRot = float(gpMount.get("base_mount_rot", 0.0))
		var gpSlotsIn: Variant = gpMount.get("label_slots", [])
		if gpSlotsIn is Array:
			gpD.gpLabelSlots = GPLabelSlot.gpFromDicts(gpSlotsIn as Array)
		gpD.gpLabelFollowsMount = bool(gpMount.get("label_follows_mount", false))
		gpD.gpPartTagKey = str(gpMount.get("part_tag_key", ""))
		gpD.gpPartTagPrefix = str(gpMount.get("part_tag_prefix", ""))
	return gpD
